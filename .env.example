# LLM (DeepSeek)
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# Database (read-only recommended for medical data)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medical_db

# Agent
MAX_CLARIFICATION_TURNS=3
MAX_SQL_REPAIRS=1
REFERENCE_DATE=2025-12-31
SQL_TIMEOUT_SECONDS=30
ENABLE_QUERY_LOGGING=true
# Optional LLM helpers. Rules stay authoritative either way; set these to false
# to run the graph with zero extra LLM calls outside SQL generation.
AMBIGUITY_LLM_SUPPLEMENT=false
CLARIFY_LLM_POLISH=true
# Per-call LLM ceiling (seconds) and retries on timeout/5xx.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Sessions and graph checkpoints (SQLite, survive restart)
SESSION_DB_PATH=data/sessions.db
CHECKPOINT_DB_PATH=data/checkpoints.db
SESSION_TTL_HOURS=24

# SQLite mirror used for execution feedback and candidate voting
SQLITE_DB_PATH=data/synthetic/medical.db
MAX_REPAIR_ROUNDS=2
SQL_LLM_EVALUATE=false
SQL_EXEC_TIMEOUT=5
SQL_MAX_ROWS=50
SQL_MAX_CANDIDATES=3

# Server
HOST=0.0.0.0
PORT=8000
