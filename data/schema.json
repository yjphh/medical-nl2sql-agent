{
  "version": "1.0.0",
  "dialect": "oracle",
  "tables": [
    {
      "name": "visit",
      "description": "就诊记录表，一行一次就诊",
      "grain": "一次就诊",
      "primary_key": [
        "out_registry_id"
      ],
      "columns": [
        {
          "name": "out_registry_id",
          "type": "VARCHAR(50)",
          "description": "挂号流水号(主键)"
        },
        {
          "name": "visit_id",
          "type": "VARCHAR(50)",
          "description": "就诊流水号"
        },
        {
          "name": "source_patient_id",
          "type": "VARCHAR(50)",
          "description": "患者主索引"
        },
        {
          "name": "id_card",
          "type": "VARCHAR(32)",
          "description": "身份证号",
          "is_pii": true
        },
        {
          "name": "treatment_occurrence_time",
          "type": "DATE",
          "description": "就诊发生时间"
        },
        {
          "name": "activity_type_code",
          "type": "VARCHAR(8)",
          "description": "业务类型代码",
          "enum_values": [
            {
              "value": "1",
              "label": "门诊"
            },
            {
              "value": "2",
              "label": "急诊"
            },
            {
              "value": "5",
              "label": "住院"
            }
          ]
        },
        {
          "name": "patient_properties_code",
          "type": "VARCHAR(20)",
          "description": "患者费用性质代码"
        },
        {
          "name": "patient_properties_name",
          "type": "VARCHAR(200)",
          "description": "患者费用性质名称"
        },
        {
          "name": "operation_counts",
          "type": "INTEGER",
          "description": "手术台次"
        },
        {
          "name": "first_visit_sign_code",
          "type": "VARCHAR(8)",
          "description": "初诊标志代码"
        },
        {
          "name": "first_visit_sign_name",
          "type": "VARCHAR(200)",
          "description": "初诊标志名称"
        },
        {
          "name": "visit_status_code",
          "type": "VARCHAR(8)",
          "description": "就诊状态代码"
        },
        {
          "name": "visit_status_name",
          "type": "VARCHAR(200)",
          "description": "就诊状态名称"
        },
        {
          "name": "operator_id",
          "type": "VARCHAR(50)",
          "description": "操作人Id"
        },
        {
          "name": "operation_time",
          "type": "DATE",
          "description": "操作时间"
        },
        {
          "name": "handle_time",
          "type": "DATE",
          "description": "处理时间"
        },
        {
          "name": "batch_no",
          "type": "VARCHAR(64)",
          "description": "批次日"
        },
        {
          "name": "modify_flag",
          "type": "VARCHAR(2)",
          "description": "修改标志"
        }
      ]
    },
    {
      "name": "medical_expense_rec",
      "description": "医疗费用记录表",
      "grain": "一次结算记录",
      "primary_key": [
        "visit_id"
      ],
      "columns": [
        {
          "name": "visit_id",
          "type": "VARCHAR(50)",
          "description": "就诊流水号"
        },
        {
          "name": "settle_date_time",
          "type": "DATE",
          "description": "结算时间"
        },
        {
          "name": "outpatient_cost",
          "type": "NUMBER",
          "description": "门诊费用"
        },
        {
          "name": "hospization_total_cost",
          "type": "NUMBER",
          "description": "住院总费用"
        },
        {
          "name": "personal_cost",
          "type": "NUMBER",
          "description": "个人自付费用"
        },
        {
          "name": "medical_cost_pay_type_code",
          "type": "VARCHAR(8)",
          "description": "医疗费用支付类型代码(医保等)"
        },
        {
          "name": "source_patient_id_type",
          "type": "VARCHAR(8)",
          "description": "患者ID类型(IV表示住院)"
        },
        {
          "name": "modify_flag",
          "type": "VARCHAR(2)",
          "description": "修改标志"
        }
      ]
    },
    {
      "name": "patient",
      "description": "患者基本信息表",
      "grain": "一个患者",
      "primary_key": [
        "source_patient_id"
      ],
      "columns": [
        {
          "name": "source_patient_id",
          "type": "VARCHAR(50)",
          "description": "患者主索引"
        },
        {
          "name": "patient_name",
          "type": "VARCHAR(100)",
          "description": "患者姓名",
          "is_pii": true
        },
        {
          "name": "sex_code",
          "type": "VARCHAR(8)",
          "description": "性别代码(1男,2女)",
          "enum_values": [
            {
              "value": "1",
              "label": "男"
            },
            {
              "value": "2",
              "label": "女"
            }
          ]
        },
        {
          "name": "birth_date",
          "type": "DATE",
          "description": "出生日期"
        },
        {
          "name": "modify_flag",
          "type": "VARCHAR(2)",
          "description": "修改标志"
        }
      ]
    },
    {
      "name": "encounter_medical_cost",
