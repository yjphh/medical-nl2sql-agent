          "description": "费用项目名称"
        },
        {
          "name": "total_cost",
          "type": "NUMBER",
          "description": "总费用"
        },
        {
          "name": "patient_type_code",
          "type": "VARCHAR(8)",
          "description": "患者类型代码"
        },
        {
          "name": "modify_flag",
          "type": "VARCHAR(2)",
          "description": "修改标志"
